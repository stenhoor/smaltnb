{
  "name": "smaltnb",
  "version": "0.0.1",
  "description": "Reactive notebooks for smaltdb",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stenhoor/smaltnb.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "default": "./dist/format.js"
    },
    "./graph": {
      "types": "./dist/graph.d.ts",
      "default": "./dist/graph.js"
    },
    "./params": {
      "types": "./dist/params.d.ts",
      "default": "./dist/params.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./kernel": {
      "types": "./dist/kernel.d.ts",
      "default": "./dist/kernel.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "deps": "node scripts/fetch-packed.mjs",
    "typecheck": "node scripts/fetch-packed.mjs --check && tsc -p . && tsc -p examples && tsc -p app",
    "test": "npm run build && node scripts/fetch-packed.mjs --check && node --test test/*.test.ts",
    "app:build": "node scripts/build-app.mjs",
    "app": "node scripts/build-app.mjs && node scripts/serve-app.mjs",
    "e2e": "node scripts/fetch-packed.mjs --check && node test/e2e/app.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.12",
    "smaltkit": "github:stenhoor/smaltkit#a70e29e6a355773e6981b26031d474177cc563e9",
    "typescript": "~5.9.0",
    "vitepress": "^1.6.4"
  },
  "peerDependencies": {
    "typescript": ">=5.5.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
