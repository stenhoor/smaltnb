{
  "name": "smaltnb",
  "version": "0.0.1",
  "description": "Reactive notebooks for smaltdb",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stenhoor/smaltnb.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "default": "./dist/format.js"
    },
    "./graph": {
      "types": "./dist/graph.d.ts",
      "default": "./dist/graph.js"
    },
    "./params": {
      "types": "./dist/params.d.ts",
      "default": "./dist/params.js"
    },
    "./md": {
      "types": "./dist/md.d.ts",
      "default": "./dist/md.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "default": "./dist/ui.js"
    },
    "./chart": {
      "types": "./dist/chart.d.ts",
      "default": "./dist/chart.js"
    },
    "./report": {
      "types": "./dist/report.d.ts",
      "default": "./dist/report.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./kernel": {
      "types": "./dist/kernel.d.ts",
      "default": "./dist/kernel.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "smaltnb": "./dist/cli/smaltnb.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.cli.json",
    "prepare": "npm run build",
    "deps": "node scripts/fetch-packed.mjs",
    "typecheck": "node scripts/fetch-packed.mjs --check && tsc -p . && tsc -p examples && tsc -p app && tsc -p tsconfig.cli.json --noEmit",
    "test": "npm run build && node scripts/fetch-packed.mjs --check && node --test test/*.test.ts",
    "app:build": "node scripts/build-app.mjs",
    "app": "node scripts/build-app.mjs && node scripts/serve-app.mjs",
    "e2e": "node scripts/fetch-packed.mjs --check && node test/e2e/app.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.12",
    "smaltkit": "github:stenhoor/smaltkit#c7d9c5c49ce1e9e14b129a6fe7bf25bc36764b7b",
    "typescript": "~5.9.0",
    "vitepress": "^1.6.4"
  },
  "peerDependencies": {
    "smaltkit": "*",
    "smaltdb": ">=0.9.0 <0.10.0",
    "smaltql": "*",
    "@smaltdb/df": "*",
    "@smaltworks/smaltdb-node": "*"
  },
  "peerDependenciesMeta": {
    "smaltkit": {
      "optional": true
    },
    "smaltdb": {
      "optional": true
    },
    "smaltql": {
      "optional": true
    },
    "@smaltdb/df": {
      "optional": true
    },
    "@smaltworks/smaltdb-node": {
      "optional": true
    }
  }
}
